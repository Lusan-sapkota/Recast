{
  "manifest_version": 3,
  "name": "Recast",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "Save any image as PNG, JPG or WebP. Conversion happens locally in your browser.",
  "permissions": ["contextMenus", "downloads", "offscreen", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Recast: convert an image",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+R" } }
  }
}
